# ============================================================
# LinkShort — Environment Variables (reference)
# ============================================================
# Local development:
#   - Copy relevant values into server/.env and client/.env
# Railway production:
#   - Set these on your Web Service (Variables tab)
#   - DATABASE_URL should reference your Railway Postgres:
#       DATABASE_URL=${{Postgres.DATABASE_URL}}
# ============================================================

# --- Required on Railway ---
NODE_ENV=production
JWT_SECRET=change_me_to_a_long_random_secret_at_least_32_chars
DATABASE_URL=postgresql://linkshort_user:linkshort_password@localhost:5432/linkshort_db

# --- Strongly recommended on Railway ---
# Your public Railway domain (no trailing slash), e.g. https://linkshort-production.up.railway.app
APP_BASE_URL=https://YOUR-RAILWAY-DOMAIN
CLIENT_ORIGIN=https://YOUR-RAILWAY-DOMAIN

# --- Optional ---
PORT=5000
JWT_EXPIRES_IN=7d
COOKIE_SECRET=change_me_cookie_secret
# DATABASE_SSL=true

# --- Frontend (local Vite only; Railway build uses /api by default) ---
VITE_API_BASE_URL=http://localhost:5000/api
