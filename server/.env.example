# ============================================================
# LinkShort — Environment Variables
# Copy to server/.env for local development.
# On Railway, set these in the Web Service Variables tab.
# ============================================================

# Server
PORT=5000
NODE_ENV=development

# PostgreSQL — local Docker Compose default (Railway injects DATABASE_URL automatically)
DATABASE_URL=postgresql://linkshort_user:linkshort_password@localhost:5432/linkshort_db
# DATABASE_SSL=true   # Optional: force SSL (auto-enabled in production for non-localhost)

# Auth
JWT_SECRET=super_secret_jwt_key_min_32_chars_long_for_security_12345!
JWT_EXPIRES_IN=7d
COOKIE_SECRET=super_secret_cookie_key_12345!

# Public URLs (local development)
CLIENT_ORIGIN=http://localhost:5173
APP_BASE_URL=http://localhost:5000

# Frontend (used at Vite build time; production build defaults to /api)
# VITE_API_BASE_URL=http://localhost:5000/api
